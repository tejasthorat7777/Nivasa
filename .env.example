# Nivasa Backend Environment Configuration

# Database
MONGODB_URI=mongodb://localhost:27017/nivasa

# Security
JWT_SECRET=nivasa_secure_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# Server
PORT=4000
CLIENT_URL=http://localhost:3000

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://10.0.2.2:3000

# bcrypt
BCRYPT_SALT=10

# Payment (optional - for future integrated gateways)
STRIPE_SECRET_KEY=
PAYMENT_METHODS=cash,bank_transfer,upi